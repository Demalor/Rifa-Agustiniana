rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /numeros/{n} {
      // Cualquiera con el link ve el tablero
      allow read: if true;

      // Apartar: solo si el número NO existe (crear nunca pisa una venta)
      allow create: if request.auth != null
        && n.matches('^[0-9]{2}$')
        && request.resource.data.numero == n
        && request.resource.data.estado in ['pendiente', 'pagado']
        && request.resource.data.comprador is string
        && request.resource.data.comprador.size() > 0
        && request.resource.data.comprador.size() <= 80
        && request.resource.data.vendedor is string
        && request.resource.data.vendedor.size() > 0
        && request.resource.data.vendedor.size() <= 60;

      // Sobre un número ya apartado solo se puede cambiar el estado de pago
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'pagadoEn'])
        && request.resource.data.estado in ['pendiente', 'pagado'];

      // Liberar un número
      allow delete: if request.auth != null;
    }
    // Marca de que los números del afiche ya se cargaron (se crea una sola vez)
    match /meta/semilla {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
